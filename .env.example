# EVOLYX Environment Configuration

# Core Deployment & Backend Mode
EVOLYX_ENV=development
EVOLYX_LOG_LEVEL=INFO
EVOLYX_MODEL_BACKEND=mock # Options: mock, transformers, vllm, llama_cpp
EVOLYX_MODEL_NAME_OR_PATH=Qwen/Qwen2.5-0.5B-Instruct

# Memory & Persistence
EVOLYX_MEMORY_BACKEND=sqlite # Options: sqlite, letta, mem0
EVOLYX_DB_PATH=artifacts/evolyx.db
EVOLYX_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# API & Server Configuration
EVOLYX_API_HOST=127.0.0.1
EVOLYX_API_PORT=8000
EVOLYX_SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Tool & Sandbox Security
EVOLYX_SANDBOX_TIMEOUT_SEC=15
EVOLYX_ALLOW_UNRESTRICTED_CODE=false
EVOLYX_WEB_SEARCH_PROVIDER=mock # Options: mock, duckduckgo, searxng

# Evolution & Gating
EVOLYX_AUTO_PROMOTE=false
EVOLYX_REQUIRE_HUMAN_APPROVAL=true
EVOLYX_CANDIDATE_OUTPUT_DIR=artifacts/models/candidates
